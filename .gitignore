# ─────────────────────────────────────────────────────────────
# WebConsole .gitignore
# ─────────────────────────────────────────────────────────────

# Runtime data (ROMs, covers, saves, SQLite DB) — never commit the contents,
# but keep the directory present via .gitkeep.
/data/*
!/data/.gitkeep

# Local user content living in the repo root — NOT project source and never
# committed: copyrighted ROM library, artwork/box-art, and media packs.
/roms/
/artworks/
/switch媒体包/


# ── Go ──
# Compiled backend binaries
/backend/webconsole
/backend/webconsole.exe
*.exe
*.test
*.out
*.prof
coverage.txt

# Embedded frontend build artifact (generated by build.sh / build.bat / Docker).
# Keep the directory (with .gitkeep) so `//go:embed all:dist` compiles on a fresh
# clone, but don't track the built output.
/backend/internal/web/dist/*
!/backend/internal/web/dist/.gitkeep

# ── Node / frontend ──
node_modules/
/frontend/dist/
/frontend/dist-ssr/
.vite/
*.local

# npm / yarn / pnpm logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Env / secrets ──
.env
.env.*
!.env.example

# ── Logs ──
*.log
logs/

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# Local agent / tooling config (machine-specific, e.g. absolute toolchain paths)
.claude/

# ── OS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
